{
  "version": 1,
  "meta": { "title": "Save an invoice", "viewport": { "w": 640, "h": 400 } },
  "steps": [
    { "type": "click", "target": { "sel": "#save", "role": "button", "name": "Save" }, "say": "Save it" },
